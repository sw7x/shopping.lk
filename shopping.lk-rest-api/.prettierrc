{
	"semi": true,
	"tabWidth": 4,
	"useTabs": true,
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"printWidth": 120,
	"singleAttributePerLine": false,
	"jsxSingleQuote": true,
	"singleQuote": true,
	"endOfLine": "auto",
	"trailingComma": "all",
	"embeddedLanguageFormatting": "auto"
}
