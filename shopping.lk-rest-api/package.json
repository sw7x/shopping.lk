		"cross-env": "^7.0.3",
		"eslint": "^9.9.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-import-resolver-typescript": "^3.6.3",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jest": "^28.8.0",
		"eslint-plugin-n": "^17.10.2",
		"eslint-plugin-prettier": "^5.2.1",
		"globals": "^15.9.0",
		"jest": "^29.7.0",
		"mongo-migrate-ts": "^1.6.2",
		"mongo-seeding": "^4.0.0",
		"nodemon": "^3.1.4",
		"prettier": "3.3.3",
		"pretty-error": "^4.0.0",
