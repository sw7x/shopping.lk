{
	"name": "shopping.lk-rest-api",
	"version": "1.0.0",
	"engines": {
		"node": ">=16.0.0"
	},
	"description": "",
	"main": "server.js",
	"scripts": {
		"build": "ts-node -r tsconfig-paths/register npm-scripts/build.ts",
		"start": "cross-env NODE_ENV=production DEBUG=false node dist/server.js",
		"test": "cross-env NODE_ENV=testing jest",
		"test:watch": "cross-env NODE_ENV=testing jest --watch",
		"test:coverage": "cross-env NODE_ENV=testing jest --coverage=true --coverageDirectory=coverage",
		"test:debug": "cross-env NODE_ENV=testing jest --debug --runInBand --verbose --detectOpenHandles",
		"dev": "cross-env PORT=4999 NODE_ENV=development nodemon",
		"dev:debug": "cross-env PORT=5001 NODE_ENV=development DEBUG=true node --inspect-brk -r ts-node/register -r tsconfig-paths/register -r source-map-support/register server.ts",
		"clean": "rimraf dist",
		"clean:all": "rimraf dist node_modules",
		"lint:check": "eslint",
		"lint:fix": "eslint --fix",
		"format:check": "prettier . --check --ignore-unknown || true && stylelint \"public/**/*.{css,scss}\"",
		"format:fix": "prettier . --write --ignore-unknown || true && stylelint \"public/**/*.{css,scss}\" --fix",
		"migrate:new": "ts-node npm-scripts/migrate.ts new",
		"migrate:up": "ts-node npm-scripts/migrate.ts up",
		"migrate:status": "ts-node npm-scripts/migrate.ts status",
		"migrate:down-all": "ts-node npm-scripts/migrate.ts down --all",
		"migrate:down-last": "ts-node npm-scripts/migrate.ts down --last"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@eslint/js": "^9.9.0",
		"@faker-js/faker": "^9.0.0",
		"@types/bcrypt": "^5.0.2",
		"@types/colors": "^1.2.4",
		"@types/config": "^3.3.4",
		"@types/cors": "^2.8.17",
		"@types/dompurify": "^3.0.5",
		"@types/eslint": "^9.6.0",
		"@types/express": "^4.17.21",
		"@types/jest": "^29.5.12",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^22.1.0",
		"@types/shelljs": "^0.8.15",
		"@types/source-map-support": "^0.5.10",
		"@types/validator": "^13.12.2",
		"@typescript-eslint/eslint-plugin": "^8.1.0",
