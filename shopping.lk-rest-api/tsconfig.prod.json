{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// Override noEmit to false (allow file generation)
		"noEmit": false,

		// Disable allowImportingTsExtensions (since we're not using .ts imports in production)
		"allowImportingTsExtensions": false,

		// Ensure outDir is set for production
		"outDir": "./dist"
	},
	"exclude": [
		"npm-scripts",
		"config",
		"database",
		"migrate.config.ts",
		"tests",
		"**/*.test.ts", // exclude test files
		"**/*.spec.ts", // exclude spec files
		"**/*.ignore.ts"
	]
}
